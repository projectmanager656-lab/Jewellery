# Copy to .env.server for the local Express API. This file contains placeholders only.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=shree_jewellers
# Generate a unique random value of at least 32 characters. Keep this server-side.
JWT_SECRET=

# Optional image storage. When omitted, image-upload APIs remain unavailable.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
