{
  "name": "shree-jewellers-catalogue",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "server:dev": "node --watch server/index.js",
    "admin:create": "node server/scripts/create-admin.js",
    "catalogue:import-samples": "node server/scripts/import-sample-catalogue.js",
    "test:backend": "node --test server/tests/*.test.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "preview": "vite preview"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.468.0",
    "mongoose": "^9.11.2",
    "multer": "^2.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
      "@vitejs/plugin-react": "^4.4.1",
      "esbuild": "^0.25.12",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.11",
    "typescript": "^7.0.2",
    "vite": "^6.3.5"
  }
}
